rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Require verified email for all write operations by parents/teachers
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function memberDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    function isActiveMember(tenantId) {
      return verified()
        && memberDoc(tenantId).exists()
        && memberDoc(tenantId).data.active == true;
    }

    function role(tenantId) {
      return memberDoc(tenantId).data.role;
    }

    function isTenantOwner(tenantId) {
      return verified() && request.auth.uid == tenantId;
    }

    function isAdmin(tenantId) {
      return isTenantOwner(tenantId) || (isActiveMember(tenantId) && role(tenantId) == "ADMIN");
    }

    function isStaff(tenantId) {
      return isTenantOwner(tenantId) || (isActiveMember(tenantId) && (role(tenantId) == "STAFF" || role(tenantId) == "ADMIN"));
    }

    function isParentOrTeacher(tenantId) {
      return isTenantOwner(tenantId) || (isActiveMember(tenantId) && (
        role(tenantId) == "PARENT" || role(tenantId) == "TEACHER" || role(tenantId) == "ADMIN"
      ));
    }

    // Child can access if:
    // - they are the tenant owner (parent/teacher)
    // OR - requester is in guardianUids
    // OR - requester is STAFF/ADMIN
    function canAccessChild(tenantId, childId) {
      return isTenantOwner(tenantId) || (isActiveMember(tenantId) && (
        isStaff(tenantId)
        || isParentOrTeacher(tenantId)
        || request.auth.uid == get(/databases/$(database)/documents/tenants/$(tenantId)/children/$(childId)).data.loginUid
        || request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)/children/$(childId)).data.guardianUids
      ));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Global children index (cross-browser student login) ───
    match /children_index/{docId} {
      // Anyone can read (students need this to log in from new devices)
      allow read: if true;

      // Only verified parents/teachers can write to the index
      allow create, update: if verified()
        && request.resource.data.tenantId is string
        && request.auth.uid == request.resource.data.tenantId;
      allow delete: if verified()
        && resource.data.tenantId is string
        && request.auth.uid == resource.data.tenantId;
    }

    // ─── Tenants root (optional metadata) ───
    match /tenants/{tenantId} {
      allow read: if signedIn() && (request.auth.uid == tenantId || isActiveMember(tenantId));
      allow write: if isTenantOwner(tenantId);
    }

    // ─── Membership management ───
    match /tenants/{tenantId}/members {
      allow list: if isTenantOwner(tenantId) || (signedIn() && isParentOrTeacher(tenantId));
    }
    match /tenants/{tenantId}/members/{uid} {
      // Users can read their own membership
      allow read: if signedIn() && (request.auth.uid == uid || isParentOrTeacher(tenantId));

      // Initial account creation: user creates their own profile during signup
      // Allowed even before email verification so the profile is saved immediately
      allow create: if signedIn()
        && request.auth.uid == uid
        && tenantId == uid
        && request.resource.data.role in ["PARENT", "TEACHER"]
        && request.resource.data.active == true;

      // Updates require verification
      allow update: if isTenantOwner(tenantId)
        && request.resource.data.id == uid;

      // Admin can manage all memberships
      allow read, update, delete: if isAdmin(tenantId);
    }

    // ─── Child profiles ───
    match /tenants/{tenantId}/children {
      allow list: if isTenantOwner(tenantId) || (signedIn() && isParentOrTeacher(tenantId));
    }
    match /tenants/{tenantId}/children/{childId} {
      allow read: if canAccessChild(tenantId, childId);

      // Create child: verified parent/teacher only
      allow create: if isParentOrTeacher(tenantId)
        && request.resource.data.tenantId == tenantId
        && request.resource.data.active == true;

      // Update child: verified parent/teacher or guardian
      allow update: if canAccessChild(tenantId, childId)
        && request.resource.data.tenantId == tenantId;

      // Delete child: tenant owner only
      allow delete: if isTenantOwner(tenantId);
    }

    // ─── Child sub-collections (drawings, stories, game data) ───
    match /tenants/{tenantId}/children/{childId}/{subcol}/{docId} {
      allow read: if canAccessChild(tenantId, childId);

      // Writes: verified user who can access the child
      allow create: if canAccessChild(tenantId, childId)
        && request.resource.data.ownerChildId == childId
        && request.resource.data.createdByUid == request.auth.uid;

      // Updates: same access level
      allow update: if canAccessChild(tenantId, childId);

      // Deletes: parent/teacher only
      allow delete: if isParentOrTeacher(tenantId);
    }

    // ─── Tenant-level events (countdown/calendar) ───
    match /tenants/{tenantId}/events/{eventId} {
      allow read: if signedIn() && (isTenantOwner(tenantId) || isActiveMember(tenantId));
      allow create, update: if isTenantOwner(tenantId) || isParentOrTeacher(tenantId);
      allow delete: if isTenantOwner(tenantId) || isParentOrTeacher(tenantId);
    }
  }
}
